# Copy to .env and fill in:  cp .env.example .env
# Jenkins login
JENKINS_ADMIN_ID=admin
JENKINS_ADMIN_PASSWORD=admin123

# Your GitHub repo (public) - Jenkins job pulls the Jenkinsfile from here
GIT_REPO_URL=https://github.com/YOUR_GITHUB_USER/springboot-devops.git

# DockerHub: username + access token (hub.docker.com > Account settings > Personal access tokens)
DOCKERHUB_USER=
DOCKERHUB_TOKEN=

# SonarQube token (localhost:9000 > My Account > Security > Generate token)
SONAR_TOKEN=

# Nexus login (the new password you set on first login at localhost:8081)
NEXUS_USER=admin
NEXUS_PASSWORD=
